{
  "name": "klai-portal-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "dev": "npm run i18n:compile && vite",
    "build": "rm -rf src/paraglide node_modules/.tmp && npm run i18n:compile && tsc -b --force && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "security:audit": "node scripts/audit-ci.mjs",
    "analyze": "npm run i18n:compile && ANALYZE=true vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:dev": "playwright test",
    "test:e2e:prod": "playwright test -c e2e/prod-tenant/_config/playwright.prod.config.ts",
    "test:e2e:prod:voys": "cross-env E2E_MODE=voys-attached E2E_BASE_URL=https://voys.getklai.com playwright test -c e2e/prod-tenant/_config/playwright.prod.config.ts",
    "e2e:capture-session": "tsx e2e/prod-tenant/_lib/capture-voys-session.ts",
    "e2e:verify-voys-session": "tsx e2e/prod-tenant/_lib/verify-voys-session.ts"
  },
  "dependencies": {
    "@blocknote/core": "^0.51.4",
    "@blocknote/mantine": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@dnd-kit/core": "^6.3.1",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@inlang/paraglide-js": "^2.20.2",
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@mantine/notifications": "^9.4.1",
    "@radix-ui/react-alert-dialog": "^1.1.18",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-slot": "^1.3.0",
    "@sentry/react": "^10.62.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-table": "^8.21.3",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.2",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "consola": "^3.4.2",
    "driver.js": "^1.6.0",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "web-vitals": "^5.3.0"
  },
  "overrides": {
    "@tiptap/core": "3.23.6",
    "@tiptap/pm": "3.23.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/router-plugin": "^1.168.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "otplib": "^13.4.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  }
}
