# Copy this to .env.local and fill in the values.
# .env.local is gitignored - never commit real values.
#
# Two modes available:
#   Mode C (Standalone) - default, no external access needed
#   Mode A/B (Production Zitadel) - for core developers with Zitadel access

# ── Mode C: Standalone (default) ─────────────────────────────────────────
# Bypasses OIDC login, proxies /api to local backend.
VITE_AUTH_DEV_MODE=true
VITE_API_PROXY_TARGET=http://localhost:8010

# ── Mode A/B: Production Zitadel (core developers only) ──────────────────
# Uncomment below and comment out Mode C settings above.
# Mode A (frontend-only): leave VITE_API_PROXY_TARGET commented - proxies to production.
# Mode B (full-stack): also uncomment VITE_API_PROXY_TARGET.
#
# VITE_AUTH_DEV_MODE=false
# VITE_OIDC_AUTHORITY=https://auth.getklai.com
# VITE_OIDC_CLIENT_ID=362901948573220875
# VITE_API_PROXY_TARGET=http://localhost:8010
