# klai-slack local configuration. Placeholders only; production values live in SOPS (klai-infra).
SLACK_CLIENT_ID=0000000000.0000000000
SLACK_CLIENT_SECRET=replace-with-slack-client-secret
SLACK_SIGNING_SECRET=replace-with-slack-signing-secret
# base64 of 32 random bytes:
# python -c 'import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())'
SLACK_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
DATABASE_URL=postgresql+asyncpg://klai_slack:replace-me@localhost:5432/klai_slack
PORTAL_API_URL=http://localhost:8010
PORTAL_INTERNAL_SECRET=replace-with-portal-api-internal-secret
INTERNAL_SECRET=replace-with-portal-api-internal-secret
PUBLIC_BASE_URL=https://slack-dev.example.com
KLAI_ENV=development
