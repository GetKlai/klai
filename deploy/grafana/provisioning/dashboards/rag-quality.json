        {
            "id": 6,
            "title": "Low-Confidence",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "victoriametrics"
            },
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 24
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "none"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "min": 0,
                    "custom": {
                        "lineWidth": 1,
                        "fillOpacity": 5
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "victoriametrics"
                    },
                    "expr": "sum by (band) (rate(retrieval_confidence_band_total{org_id=\"$org_id\"}[$__rate_interval]))",
                    "legendFormat": "{{band}}",
                    "refId": "A"
                },
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "victoriametrics"
                    },
                    "expr": "sum(rate(retrieval_link_expand_top_k_total{outcome=\"hit\",org_id=\"$org_id\"}[$__rate_interval])) / sum(rate(retrieval_link_expand_top_k_total{org_id=\"$org_id\"}[$__rate_interval]))",
                    "legendFormat": "survival rate",
                    "refId": "B"
                },
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "victoriametrics"
                    },
                    "expr": "sum by (reason) (rate(litellm_low_confidence_injection_total{org_id=\"$org_id\"}[$__rate_interval]))",
                    "legendFormat": "{{reason}}",
                    "refId": "C"
                }
            ]
        }
