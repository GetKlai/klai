{
    "annotations": {
        "list": []
    },
    "description": "RAG retrieval quality \u2014 nightly RAGAS metrics per suite + variant. SPEC-RAG-EVAL-001.",
    "editable": false,
    "graphTooltip": 1,
    "id": null,
    "links": [],
    "panels": [
        {
            "id": 1,
            "title": "Context precision (7-day moving average)",
            "type": "timeseries",
            "datasource": {
                "type": "postgres",
                "uid": "portal-postgres"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "min": 0,
                    "max": 1,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 0.6
                            },
                            {
                                "color": "green",
                                "value": 0.8
                            }
                        ]
                    }
                },
                "overrides": []
            },
            "targets": [
                {
                    "datasource": {
                        "type": "postgres",
                        "uid": "portal-postgres"
                    },
                    "rawSql": "WITH daily AS (SELECT date_trunc('day', run_at) AS day, suite, AVG(context_precision) AS metric FROM knowledge.rag_eval_results WHERE run_at >= $__timeFrom() AND run_at <= $__timeTo() AND variant = '$variant' GROUP BY 1, 2) SELECT day AS time, suite AS metric, AVG(metric) OVER (PARTITION BY suite ORDER BY day ROWS BETWEEN 6 PRECEDING AND CURRENT ROW) AS value FROM daily ORDER BY day",
                    "format": "time_series",
                    "refId": "A"
                }
            ]
        },
