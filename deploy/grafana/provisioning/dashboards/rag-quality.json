                    "placement": "bottom"
                }
            },
            "targets": [
                {
                    "datasource": {
                        "type": "postgres",
                        "uid": "portal-postgres"
                    },
                    "rawSql": "SELECT date_trunc('day', run_at) AS time, suite AS metric, COUNT(*) FILTER (WHERE faithfulness IS NULL) AS value FROM knowledge.rag_eval_results WHERE run_at >= $__timeFrom() AND run_at <= $__timeTo() AND variant = '$variant' GROUP BY 1, 2 ORDER BY 1",
                    "format": "time_series",
                    "refId": "A"
