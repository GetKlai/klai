        {
            "id": 5,
            "title": "Failed-row count per nightly run (NULL metrics)",
            "type": "timeseries",
            "datasource": {
                "type": "postgres",
                "uid": "portal-postgres"
            },
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
