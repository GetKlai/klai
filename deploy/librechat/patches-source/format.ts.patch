+/**
+ * Klai patch — defensive guards against malformed message payloads.
+ *
+ * Upstream assumes every message/content entry is a well-formed object. Klai
+ * traffic reaches these functions through LiteLLM, tenant KB retrieval and the
+ * MCP layer, where a provider hiccup can yield a string, null or number where
+ * an object is expected. Upstream then throws deep inside the formatter and the
+ * whole turn fails. These guards degrade to a warning + skip instead, so one bad
+ * entry cannot take down a conversation.
+ *
+ * Each guard logs with the `[klai-patch]` prefix so the frequency is queryable
+ * in VictoriaLogs; `warnOnce` is used where the call site is per-message and
+ * would otherwise flood the log.
+ */
+const isRecord = (value: unknown): value is Record<string, any> =>
+  value != null && typeof value === 'object';
+
+const _klaiWarned = new Set<string>();
+const warnOnce = (message: string): void => {
+  if (_klaiWarned.has(message)) return;
+  _klaiWarned.add(message);
+  console.warn(`[klai-patch] ${message}`);
+};
