  "type": "app",
  "config": {
    "description": "Generate Klai knowledgebase-backed draft replies from HubSpot Help Desk tickets.",
    "name": "Klai Email Support",
    "distribution": "private",
    "auth": {
      "type": "static",
      "requiredScopes": [
        "oauth",
        "crm.objects.contacts.read",
        "tickets",
